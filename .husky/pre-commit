# Block likely secrets, then syntax-check staged API files
# Allowlisted as public-by-design: js/auth.js holds the Firebase *web* client
# config (safe to be public; security rests on Firestore rules).
if git diff --cached -U0 -- . ':(exclude).husky' ':(exclude)js/auth.js' \
  | grep -iE "(sk-(live|test)-[a-zA-Z0-9]{10}|whsec_[a-zA-Z0-9]|AIzaSy[A-Za-z0-9_-]{20}|BEGIN (RSA |EC )?PRIVATE KEY)" >/dev/null; then
  echo "COMMIT BLOCKED: possible API key/secret in staged changes."
  echo "If this is a false positive, commit with --no-verify and tell the team."
  exit 1
fi
npx lint-staged
