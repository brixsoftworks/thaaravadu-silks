# Server-side secrets — never commit. Set in Vercel project env vars.
STRIPE_SECRET_KEY=<your_stripe_secret_key>
# Webhook signing secret (Stripe dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=<your_webhook_signing_secret>
# Firebase Admin service-account JSON as a single string (for the webhook);
# generate in Firebase console -> Project settings -> Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=<the_entire_service_account_json>
